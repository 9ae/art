---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Art</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="#stories">Stories</a>
        <a href="#about">About Me</a>
      </nav>
    </header>
    <main>
      <section id="stories">
        <h2>Stories</h2>
        <p>Stories coming soon.</p>
      </section>
      <section id="about">
        <h2>About Me</h2>
        <p>About me coming soon.</p>
      </section>
    </main>
  </body>
</html>
<style is:global>
  html { scroll-behavior: smooth; }
  body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.6; }
  header { position: sticky; top: 0; background: #fff; border-bottom: 1px solid #ddd; }
  nav { display: flex; gap: 1.5rem; padding: 1rem 2rem; }
  nav a { color: inherit; text-decoration: none; font-weight: 600; }
  nav a:hover { text-decoration: underline; }
  section { min-height: 100vh; padding: 5rem 2rem 2rem; max-width: 60rem; margin: 0 auto; scroll-margin-top: 3rem; }
</style>
