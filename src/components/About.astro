---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import '../styles/about.css';

const entry = await getEntry('blocks', 'about');
const { Content } = await render(entry!);
const { heading = 'About Me', portrait, portraitAlt = '' } = entry!.data;
---

<section id="about" class="section">
  <h2 class="section-heading">{heading}</h2>
  <div class="about">
    {
      portrait ? (
        <Image class="about-portrait" src={portrait} alt={portraitAlt} width={320} />
      ) : (
        <div class="about-portrait-placeholder" role="img" aria-label="Portrait placeholder">
          [PORTRAIT]
        </div>
      )
    }
    <div class="about-text prose"><Content /></div>
  </div>
</section>
