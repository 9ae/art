---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import '../styles/illustration.css';

const entries = (await getCollection('illustrations')).sort((a, b) => a.data.order - b.data.order);
const illustrations = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    id: entry.id,
    Content: (await render(entry)).Content,
  })),
);
---

<section id="illustration" class="section">
  <h2 class="section-heading">Illustration</h2>
  <div class="illustration-list">
    {
      illustrations.map((item) => (
        <figure class="illustration">
          <div class="illustration-images">
            {item.images.map((img) => (
              <Image
                class="illustration-image"
                src={img.src}
                alt={img.alt}
                widths={[480, 800, 1200]}
                sizes={`(max-width: 640px) 90vw, ${Math.round(760 / item.images.length)}px`}
              />
            ))}
          </div>
          <figcaption class="illustration-caption">
            <h3 class="illustration-title">{item.title}</h3>
            <div class="prose">
              <item.Content />
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
